---
import SplitHeading from '../home/SplitHeading.astro';
import VideoPlayer from '../shared/VideoPlayer.astro';
---

<section class="flash" aria-labelledby="flash-title">
  <div class="stripes stripes--l" aria-hidden="true"></div>
  <div class="head">
    <div data-reveal><p class="eyebrow">03 — Open doors</p></div>
    <SplitHeading id="flash-title" class="h2" lines={['Flash Day', 'Edición Zero']} />
    <div data-reveal>
      <p class="lead">
        A space open to artists passing through Granada who want to train, meet, share and become part of the creative
        environment around the company.
      </p>
    </div>
  </div>
  <div class="video" data-reveal>
    <VideoPlayer src="/video/flashday.mp4" poster="/video/flashday-poster.jpg" title="Flash Day — Edición Zero" />
  </div>
</section>

<style>
  .flash {
    position: relative;
    padding: var(--section-y) var(--gutter);
    display: grid; grid-template-columns: 4fr 7fr; gap: clamp(40px, 6vw, 96px); align-items: center;
    background: linear-gradient(180deg, var(--ink) 0%, var(--ink-deep) 100%);
    overflow: hidden;
  }
  .stripes {
    position: absolute; top: 0; bottom: 0; width: 96px; opacity: 0.1;
    background: repeating-linear-gradient(90deg, var(--cream) 0 8px, transparent 8px 16px);
    animation: aa-stripe 20s linear infinite;
  }
  .stripes--l { left: 0; }
  .head { position: relative; display: flex; flex-direction: column; gap: 24px; }
  .lead { max-width: 440px; }

  @media (max-width: 960px) {
    .flash { grid-template-columns: 1fr; }
  }
</style>
