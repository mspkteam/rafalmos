---
import SplitHeading from '../home/SplitHeading.astro';
import Spotlight from '../home/Spotlight.astro';
---

<section class="studio-hero" aria-labelledby="page-title" data-studio>
  <Spotlight size={900} strength={0.22} />
  <div class="bgword" aria-hidden="true"><span data-bgword>{'Granada · Spain · '.repeat(4)}</span></div>

  <div class="copy">
    <div data-reveal><p class="eyebrow">Our Studio · Granada, Spain</p></div>
    <SplitHeading as="h1" id="page-title" class="title" lines={['A space to', 'train, create', 'and connect']} />
    <div class="text lead" data-reveal>
      <p>
        Our studio in Granada, Spain is the home of Arte Algo, a place where we develop our own work, train, experiment
        and bring new ideas to life.
      </p>
      <p>
        It is also a space open to artists passing through Granada who want to train, meet, share and become part of the
        creative environment around the company.
      </p>
    </div>
  </div>

  <div class="phone" data-tilt data-tilt-max="6">
    <div class="phone-line" aria-hidden="true"></div>
    <video autoplay muted loop playsinline preload="metadata" poster="/video/studio-vertical-poster.jpg" aria-label="Inside the Arte Algo studio in Granada" data-autoplay>
      <source src="/video/studio-vertical.mp4" type="video/mp4" />
    </video>
  </div>
</section>

<style>
  .studio-hero {
    position: relative;
    min-height: max(700px, 100svh);
    display: grid; grid-template-columns: 7fr 5fr; gap: clamp(40px, 6vw, 96px); align-items: center;
    padding: calc(var(--header-h) + 60px) var(--gutter) 120px;
    background:
      radial-gradient(50% 60% at 80% 40%, rgb(var(--orange-rgb) / 0.3), transparent 70%),
      radial-gradient(40% 50% at 10% 90%, rgb(var(--amber-rgb) / 0.12), transparent 70%),
      var(--ink);
    overflow: hidden;
  }
  .bgword { position: absolute; left: 0; right: 0; bottom: 40px; overflow: hidden; pointer-events: none; user-select: none; }
  .bgword span {
    display: inline-block; white-space: nowrap;
    font: 700 clamp(120px, 17vw, 260px)/0.9 var(--font-display); text-transform: uppercase;
    color: transparent; -webkit-text-stroke: 1px rgb(var(--amber-rgb) / 0.12);
  }
  .copy { position: relative; display: flex; flex-direction: column; gap: 26px; }
  .copy :global(.title) { font-size: clamp(3rem, 7vw, 7rem); line-height: 0.9; }
  .text { display: flex; flex-direction: column; gap: 1em; max-width: 560px; }

  .phone { position: relative; justify-self: center; width: min(380px, 100%); aspect-ratio: 9 / 16; }
  .phone video { position: relative; width: 100%; height: 100%; object-fit: cover; box-shadow: var(--shadow-photo); }
  .phone-line { position: absolute; inset: -18px 18px 18px -18px; border: 1px solid rgb(var(--amber-rgb) / 0.35); }

  @media (max-width: 960px) {
    .studio-hero { grid-template-columns: 1fr; padding-bottom: 90px; }
    .phone { width: min(320px, 80vw); }
  }
</style>
