---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import SplitHeading from '../home/SplitHeading.astro';
import s1 from '../../assets/home/studio/studio-1.jpg';
import s3 from '../../assets/home/studio/studio-3.jpg';
import s4 from '../../assets/home/studio/studio-4.jpg';
import s5 from '../../assets/home/studio/studio-5.jpg';

interface Use {
  title: string;
  text: string;
  image: ImageMetadata;
}

// Wording taken from the client's studio text.
const uses: Use[] = [
  { title: 'Train', text: 'A home for daily training — for the company and for artists passing through Granada.', image: s3 },
  { title: 'Create', text: 'Where we develop our own work and new pieces are built and rehearsed.', image: s1 },
  { title: 'Experiment', text: 'Room to experiment, test ideas and bring them to life.', image: s4 },
  { title: 'Connect', text: 'A place to meet, share and become part of the creative environment around the company.', image: s5 },
];
---

<section class="uses" aria-labelledby="uses-title">
  <div class="head">
    <div data-reveal><p class="eyebrow">01 — The space</p></div>
    <SplitHeading id="uses-title" class="h2" lines={['One space,', 'four ways in']} />
  </div>

  <ol class="stack">
    {uses.map((u, i) => (
      <li class="card" style={`--i: ${i}`} data-stack-card>
        <div class="card-inner">
          <div class="txt">
            <span class="num">{String(i + 1).padStart(2, '0')} / {String(uses.length).padStart(2, '0')}</span>
            <h3>{u.title}</h3>
            <p>{u.text}</p>
          </div>
          <div class="img"><Image src={u.image} alt={`Arte Algo studio — ${u.title.toLowerCase()}`} widths={[400, 700]} sizes="(max-width: 760px) 90vw, 420px" /></div>
        </div>
      </li>
    ))}
  </ol>
</section>

<style>
  .uses {
    position: relative;
    padding: var(--section-y) var(--gutter);
    background: linear-gradient(180deg, var(--ink) 0%, var(--ember-2) 60%, var(--ink) 100%);
  }
  .head { display: flex; flex-direction: column; gap: 24px; margin-bottom: 64px; }

  .stack { margin: 0 auto; padding: 0; list-style: none; max-width: 1100px; }
  .card {
    position: sticky; top: calc(var(--header-h) + 24px + var(--i) * 22px);
    margin-bottom: 40px;
  }
  .card-inner {
    display: grid; grid-template-columns: 1fr 42%; gap: clamp(24px, 4vw, 56px); align-items: center;
    padding: clamp(24px, 3.5vw, 48px);
    background: var(--ink-card);
    box-shadow: 0 -10px 60px rgb(0 0 0 / 0.5), 0 0 0 1px rgb(var(--amber-rgb) / 0.2);
    transform-origin: 50% 0;
    will-change: transform;
  }
  .txt { display: flex; flex-direction: column; gap: 16px; }
  .num { font: 600 12px/1 var(--font-body); letter-spacing: 0.24em; color: var(--amber); }
  h3 { font-size: clamp(48px, 7vw, 104px); line-height: 0.9; }
  .txt p { max-width: 440px; color: var(--text); line-height: 1.6; font-size: 1.05em; }
  .img { aspect-ratio: 4 / 5; overflow: hidden; }
  .img img { width: 100%; height: 100%; object-fit: cover; }

  @media (max-width: 760px) {
    .card-inner { grid-template-columns: 1fr; }
    .img { aspect-ratio: 16 / 10; order: -1; }
  }
</style>
