---
import Strip, { type StripItem } from './Strip.astro';
import cirqueDuSoleil from '../../assets/home/media/cirque-du-soleil.jpg';
import friedrichstadt from '../../assets/home/media/friedrichstadt-palast.jpg';
import eloize from '../../assets/home/media/cirque-eloize.jpg';
import knie from '../../assets/home/media/circus-knie.jpg';
import sevenFingers from '../../assets/home/media/the-7-fingers.jpg';
import gotTalent from '../../assets/home/media/got-talent-france.jpg';
import oneDrop from '../../assets/home/media/one-night-one-drop.jpg';
import laMerce from '../../assets/home/media/la-merce.jpg';

const items: StripItem[] = [
  { image: cirqueDuSoleil, alt: 'Arte Algo with Cirque du Soleil, 2017–2019', w: 300, h: 420 },
  { image: friedrichstadt, alt: 'Arte Algo at Friedrichstadt-Palast, Berlin, 2025–27', w: 520, h: 340 },
  { image: eloize, alt: 'Arte Algo in Cirque Éloize — ID Evolution, 2026–27', w: 300, h: 400 },
  { image: knie, alt: 'Arte Algo with Circus Knie, 2022', w: 420, h: 300 },
  { image: sevenFingers, alt: 'Arte Algo in The 7 Fingers — Duel Reality, 2023–24', w: 320, h: 440 },
  { image: gotTalent, alt: 'Arte Algo on Got Talent France, 2025', w: 480, h: 320 },
  { image: oneDrop, alt: 'Arte Algo at One Night for One Drop, Cirque du Soleil, 2019', w: 300, h: 400 },
  { image: laMerce, alt: 'Arte Algo at La Mercè, Barcelona, 2021', w: 440, h: 320 },
];
---

<section id="media" class="media" aria-labelledby="media-title">
  <div class="head">
    <div class="title" data-reveal>
      <p class="eyebrow" style="--i: 0">05 — Selected moments</p>
      <h2 id="media-title" class="h2" style="--i: 1">Media</h2>
    </div>
    <a href="/#contact" class="btn btn--solid btn-desktop">View all media</a>
  </div>

  <Strip items={items} label="Selected media — drag or swipe to browse, select a photo to enlarge" duration={60} mobileScale={0.52} lightbox align="center" cursor="View" />
  <a href="/#contact" class="btn btn--solid btn-mobile">View all media</a>

  <dialog class="lightbox" data-lightbox aria-label="Media viewer">
    <form method="dialog"><button class="close" aria-label="Close">×</button></form>
    <figure>
      <img src="" alt="" data-lightbox-img />
      <figcaption data-lightbox-cap></figcaption>
    </figure>
  </dialog>
</section>

<style>
  .media {
    position: relative;
    padding: 140px 0 160px;
    background: linear-gradient(180deg, var(--ink) 0%, var(--ink-deep) 40%, var(--ink-deep) 80%, var(--ember-1) 100%);
  }
  .head {
    display: flex; justify-content: space-between; align-items: flex-end; gap: 24px;
    padding: 0 var(--gutter); margin-bottom: 52px;
  }
  .title { display: flex; flex-direction: column; gap: 24px; }
  .btn-mobile { display: none; }

  .lightbox {
    max-width: min(92vw, 1400px); max-height: 92vh;
    padding: 0; border: 0; background: transparent; color: var(--cream); overflow: visible;
  }
  .lightbox::backdrop { background: rgb(var(--ink-rgb) / 0.92); }
  .lightbox figure { margin: 0; display: flex; flex-direction: column; gap: 14px; }
  .lightbox img { max-width: 100%; max-height: calc(92vh - 50px); width: auto; height: auto; margin: 0 auto; box-shadow: 0 30px 90px rgb(0 0 0 / 0.7); }
  .lightbox figcaption {
    text-align: center; color: var(--text-soft);
    font: 500 12px/1.4 var(--font-body); letter-spacing: 0.2em; text-transform: uppercase;
  }
  .close {
    position: fixed; top: 16px; right: 16px;
    width: 48px; height: 48px; border-radius: 50%;
    border: 1px solid var(--amber); background: rgb(var(--ink-rgb) / 0.7); color: var(--cream);
    font: 400 28px/1 var(--font-body); cursor: pointer;
  }
  .close:hover { background: var(--orange); color: var(--ink); }

  @media (max-width: 760px) {
    .media { padding: 100px 0 110px; }
    .head { padding: 0 24px; margin-bottom: 24px; }
    .title { gap: 22px; }
    .btn-desktop { display: none; }
    .btn-mobile { display: flex; width: auto; margin: 36px 24px 0; }
  }
</style>
