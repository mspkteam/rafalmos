---
import Strip, { type StripItem } from './Strip.astro';
import Lightbox from '../shared/Lightbox.astro';
import { pages } from '../../data/site';
import cirqueDuSoleil from '../../assets/home/media/cirque-du-soleil.jpg';
import friedrichstadt from '../../assets/home/media/friedrichstadt-palast.jpg';
import eloize from '../../assets/home/media/cirque-eloize.jpg';
import knie from '../../assets/home/media/circus-knie.jpg';
import sevenFingers from '../../assets/home/media/the-7-fingers.jpg';
import gotTalent from '../../assets/home/media/got-talent-france.jpg';
import oneDrop from '../../assets/home/media/one-night-one-drop.jpg';
import laMerce from '../../assets/home/media/la-merce.jpg';

// Captions = the client's photo titles (Google Drive). Downloads replaced "/", "|" and ":" with "_";
// restored here — confirm against the Drive originals.
const items: StripItem[] = [
  { image: cirqueDuSoleil, caption: 'CIRQUE DU SOLEIL 2017-2019', alt: 'Arte Algo with Cirque du Soleil, 2017–2019', w: 300, h: 420 },
  { image: friedrichstadt, caption: 'FRIEDRICHSTADT-PALAST | 2025-27', alt: 'Arte Algo at Friedrichstadt-Palast, 2025–27', w: 520, h: 340 },
  { image: eloize, caption: 'CIRQUE ELOIZE ID EVOLUTION: 2026/27', alt: 'Arte Algo in Cirque Éloize ID Evolution, 2026/27', w: 300, h: 400 },
  { image: knie, caption: 'CIRCUS KNIE 2022', alt: 'Arte Algo with Circus Knie, 2022', w: 420, h: 300 },
  { image: sevenFingers, caption: 'THE7FINGERS | DUEL REALITY 2023/24', alt: 'Arte Algo in The 7 Fingers Duel Reality, 2023/24', w: 320, h: 440 },
  { image: gotTalent, caption: 'GOT TALENT FRANCE | 2025', alt: 'Arte Algo on Got Talent France, 2025', w: 480, h: 320 },
  { image: oneDrop, caption: 'ONE NIGHT FOR ONE DROP | CIRQUE DU SOLEIL | 2019', alt: 'Arte Algo at One Night for One Drop, Cirque du Soleil, 2019', w: 300, h: 400 },
  { image: laMerce, caption: 'LA MERCE 2021', alt: 'Arte Algo at La Mercè, 2021', w: 440, h: 320 },
];
---

<section id="media" class="media" aria-labelledby="media-title">
  <div class="head">
    <div class="title" data-reveal>
      <p class="eyebrow" style="--i: 0">05 — Selected moments</p>
      <h2 id="media-title" class="h2" style="--i: 1">Media</h2>
    </div>
    <a href={pages.media} class="btn btn--solid btn-desktop">View all media</a>
  </div>

  <Strip items={items} label="Selected media — drag or swipe to browse, select a photo to enlarge" duration={60} mobileScale={0.52} lightbox align="center" cursor="View" />
  <a href={pages.media} class="btn btn--solid btn-mobile">View all media</a>

  <Lightbox />
</section>

<style>
  .media {
    position: relative;
    padding: 140px 0 160px;
    background: linear-gradient(180deg, var(--ink) 0%, var(--ink-deep) 40%, var(--ink-deep) 80%, var(--ember-1) 100%);
  }
  .head {
    display: flex; justify-content: space-between; align-items: flex-end; gap: 24px;
    padding: 0 var(--gutter); margin-bottom: 52px;
  }
  .title { display: flex; flex-direction: column; gap: 24px; }
  .btn-mobile { display: none; }

  @media (max-width: 760px) {
    .media { padding: 100px 0 110px; }
    .head { padding: 0 24px; margin-bottom: 24px; }
    .title { gap: 22px; }
    .btn-desktop { display: none; }
    .btn-mobile { display: flex; width: auto; margin: 36px 24px 0; }
  }
</style>
