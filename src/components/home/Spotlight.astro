---
interface Props {
  /** Diameter of the light in px (desktop). */
  size?: number;
  strength?: number;
}

const { size = 720, strength = 0.22 } = Astro.props;
---

<div class="spot-layer" aria-hidden="true">
  <div class="spot" data-spot style={`--size: ${size}px; --strength: ${strength}`}></div>
</div>

<style>
  .spot-layer { position: absolute; inset: 0; overflow: hidden; pointer-events: none; }
  .spot {
    position: absolute; left: 0; top: 0;
    width: var(--size); height: var(--size);
    margin: calc(var(--size) / -2) 0 0 calc(var(--size) / -2);
    border-radius: 50%;
    background: radial-gradient(circle, rgb(var(--amber-rgb) / var(--strength)), rgb(var(--orange-rgb) / 0.06) 45%, transparent 70%);
    opacity: 0;
    will-change: transform, opacity;
  }
</style>
