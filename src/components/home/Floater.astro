---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  image: ImageMetadata;
  /** Scroll travel at full desktop scale (px, px, deg); scaled down on small screens. */
  x?: number;
  y: number;
  r?: number;
  width: number;
  class?: string;
}

const { image, x = 0, y, r = 0, width, class: className } = Astro.props;
---

<div class:list={['floater', className]} data-float data-x={x} data-y={y} data-r={r} data-depth="28" aria-hidden="true">
  <Image src={image} alt="" widths={[Math.round(width * 0.55), width]} sizes={`(max-width: 760px) ${Math.round(width * 0.55)}px, ${width}px`} />
</div>

<style>
  .floater {
    position: absolute; z-index: 20; pointer-events: none;
    aspect-ratio: 2 / 3;
  }
  .floater img {
    width: 100%; height: 100%; object-fit: contain;
    will-change: transform;
    filter: drop-shadow(0 30px 50px rgb(0 0 0 / 0.55)) drop-shadow(0 0 40px rgb(var(--orange-rgb) / 0.24));
  }
  @media (max-width: 760px) {
    .floater img { filter: drop-shadow(0 20px 30px rgb(0 0 0 / 0.6)); }
  }
</style>
