---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  image: ImageMetadata;
  alt: string;
  sizes: string;
  class?: string;
}

const { image, alt, sizes, class: className } = Astro.props;
---

<div class:list={['photo', className]} style={{ aspectRatio: `${image.width} / ${image.height}` }} data-tilt data-tilt-max="5">
  <Image src={image} alt={alt} widths={[480, 800, 1200, image.width]} sizes={sizes} data-photo-parallax />
</div>

<style>
  .photo { position: relative; overflow: hidden; box-shadow: var(--shadow-photo); }
  .photo img {
    position: absolute; left: 0; top: -7.5%;
    width: 100%; height: 115%; object-fit: cover;
    will-change: transform;
  }
</style>
