---
import Floater from './Floater.astro';
import ParallaxPhoto from './ParallaxPhoto.astro';
import vision from '../../assets/home/vision.png';
import pacoFlip from '../../assets/home/float-paco-flip.png';
---

<section id="vision" class="vision" aria-labelledby="vision-title">
  <div class="glow glow--left" data-parallax="140"><span></span></div>

  <div class="copy" data-reveal>
    <p class="eyebrow" style="--i: 0">01 — Who we are</p>
    <h2 id="vision-title" class="h2" style="--i: 1">Artistic<br />Vision</h2>
    <p class="lead" style="--i: 2">
      Arte Algo is a contemporary circus company from Granada, Spain, founded by Rafa and Paco Olmos. We create and
      perform original productions, collaborate with other artists and organisations, and explore new ways of bringing
      circus to different spaces and audiences.
    </p>
    <a href="/#founders" class="line-link" style="--i: 3">Our story</a>
  </div>

  <div class="figure">
    <div class="outline" data-parallax="-30" aria-hidden="true"></div>
    <ParallaxPhoto
      image={vision}
      alt="Acrobatic shoes flying above a teeterboard at sunset over Granada"
      sizes="(max-width: 960px) calc(100vw - 48px), 720px"
    />
  </div>

  <Floater image={pacoFlip} width={380} x={140} y={220} r={34} class="f2" />
</section>

<style>
  .vision {
    position: relative;
    padding: var(--section-y) var(--gutter) calc(var(--section-y) + 20px);
    display: grid; grid-template-columns: 5fr 7fr; gap: clamp(48px, 6vw, 88px); align-items: center;
    background: radial-gradient(50% 60% at 88% 55%, rgb(var(--orange-rgb) / 0.32), transparent 70%), var(--ink);
  }
  .glow--left { left: -200px; top: 120px; width: 700px; height: 700px; }
  .glow--left span { background: radial-gradient(circle, rgb(160 70 25 / 0.35), transparent 65%); }

  .copy { position: relative; display: flex; flex-direction: column; gap: 28px; }
  .lead { max-width: 460px; }

  .figure { position: relative; }
  .outline {
    position: absolute; inset: -28px -28px 28px 28px;
    border: 1px solid rgb(var(--amber-rgb) / 0.35);
  }

  .vision :global(.f2) { left: 40px; bottom: -300px; width: 380px; }

  @media (max-width: 960px) {
    .vision { grid-template-columns: 1fr; gap: 38px; }
    .figure { order: 2; }
    .outline { inset: -14px -14px 14px 14px; }
  }
  @media (max-width: 760px) {
    .vision {
      padding-block: 150px 160px;
      background: radial-gradient(80% 40% at 90% 70%, rgb(var(--orange-rgb) / 0.32), transparent 70%), var(--ink);
    }
    .copy { gap: 22px; }
    .glow--left { width: 420px; height: 420px; }
    .vision :global(.f2) { left: -30px; bottom: -150px; width: 200px; }
  }
</style>
