---
import { pages } from '../../data/site';
import Spotlight from './Spotlight.astro';

interface Props {
  eyebrow?: string;
}

const { eyebrow = '06 — Contact' } = Astro.props;
---

<section id="contact" class="cta" aria-labelledby="cta-title">
  <div class="stripes stripes--l" aria-hidden="true"></div>
  <div class="stripes stripes--r" aria-hidden="true"></div>
  <div class="glow glow--spot" style="--breathe: 10s"><span></span></div>
  <Spotlight size={760} strength={0.2} />

  <div class="inner" data-reveal>
    <p class="eyebrow">{eyebrow}</p>
    <h2 id="cta-title">Let's work<br />together</h2>
    <div class="text">
      <p>We'd love to hear your ideas and explore what we can create together.</p>
      <p>
        Whether you're an artist interested in working with us, a company looking to develop a new production, or
        someone planning a show, festival or special event, we're always open to new projects and collaborations.
      </p>
    </div>
    <a href={pages.contact} class="btn btn--light">Get in touch</a>
  </div>
</section>

<style>
  .cta {
    position: relative; overflow: hidden;
    padding: 180px var(--gutter) 200px;
    background:
      radial-gradient(30% 40% at 50% 0%, rgb(var(--amber-rgb) / 0.14), transparent 70%),
      var(--ember-1);
  }
  .glow--spot { left: 0; right: 0; bottom: -35%; height: 100%; }
  .glow--spot span { border-radius: 50%; background: radial-gradient(50% 70% at 50% 100%, rgb(var(--orange-rgb) / 0.6), transparent 70%); }

  .stripes {
    position: absolute; top: 0; bottom: 0; width: 96px; opacity: 0.14;
    background: repeating-linear-gradient(90deg, var(--cream) 0 8px, transparent 8px 16px);
    animation: aa-stripe 20s linear infinite;
  }
  .stripes--l { left: 0; }
  .stripes--r { right: 0; animation-direction: reverse; }

  .inner {
    position: relative; max-width: 760px; margin: 0 auto;
    display: flex; flex-direction: column; align-items: center; gap: 32px; text-align: center;
  }
  h2 { font-size: var(--fs-cta); line-height: 0.88; }
  .text {
    display: flex; flex-direction: column; gap: 1em;
    line-height: 1.7; color: var(--text);
  }
  .text p:first-child { color: var(--cream); font-size: 1.15em; }
  .inner .btn { margin-top: 12px; }

  @media (max-width: 760px) {
    .cta { padding: 110px 24px 120px; }
    .stripes { width: 14px; opacity: 0.16; background: repeating-linear-gradient(90deg, var(--cream) 0 4px, transparent 4px 8px); animation: none; }
    .inner { gap: 22px; }
    h2 { font-size: 64px; }
    .inner .btn { width: 100%; height: 56px; font-size: 13px; }
  }
</style>
