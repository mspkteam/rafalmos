---
import { Image } from 'astro:assets';
import SplitHeading from '../home/SplitHeading.astro';
import Spotlight from '../home/Spotlight.astro';
import { pages } from '../../data/site';
import stage from '../../assets/about/hero-stage.jpg';
---

<!-- Same photograph as the opening, tighter and darker: a visual return, not a repeat. -->
<section class="next" aria-labelledby="next-title" data-mouse-zone>
  <div class="bg" data-hero-bg>
    <Image src={stage} alt="" widths={[800, 1400, 2000]} sizes="100vw" />
  </div>
  <div class="light" aria-hidden="true"></div>
  <Spotlight size={900} strength={0.2} />

  <div class="copy">
    <div data-reveal><p class="eyebrow">05 — The next chapter</p></div>
    <SplitHeading id="next-title" class="title" lines={['We have spent years', 'performing around the world.']} />
    <div data-reveal><p class="answer">Now we want to build the worlds ourselves.</p></div>
    <div data-reveal><a href={pages.contact} class="btn btn--light">Get in touch</a></div>
  </div>
</section>

<style>
  .next {
    position: relative; overflow: hidden;
    min-height: max(620px, 92svh);
    display: flex; align-items: center; justify-content: center; text-align: center;
    padding: var(--section-y) var(--gutter);
  }
  .bg { position: absolute; inset: 0; overflow: hidden; }
  .bg img {
    width: 100%; height: 115%; object-fit: cover; object-position: 50% 30%;
    transform-origin: 50% 40%; scale: 1.6;
    filter: grayscale(0.35) brightness(0.55);
  }
  .light {
    position: absolute; inset: 0; pointer-events: none;
    background:
      radial-gradient(50% 45% at 50% 50%, rgb(var(--orange-rgb) / 0.22), transparent 70%),
      linear-gradient(180deg, var(--ink) 0%, rgb(var(--ink-rgb) / 0.55) 25%, rgb(var(--ink-rgb) / 0.55) 75%, var(--ink) 100%);
  }
  .copy { position: relative; z-index: 2; display: flex; flex-direction: column; align-items: center; gap: 28px; max-width: 1100px; }
  .copy :global(.title) { font-size: clamp(2.6rem, 6.2vw, 6rem); line-height: 0.95; text-shadow: 0 4px 40px rgb(0 0 0 / 0.55); }
  .answer {
    font: 700 clamp(1.6rem, 3.4vw, 3rem)/1.05 var(--font-display); text-transform: uppercase;
    color: var(--amber);
  }
</style>
