---
import { Image } from 'astro:assets';
import SplitHeading from '../home/SplitHeading.astro';
import type { Project } from '../../data/about';

interface Props {
  id: string;
  eyebrow: string;
  lines: string[];
  lead: string;
  items: Project[];
  /** Background variant so the two sequences read as related but distinct. */
  tone?: 'ember' | 'deep';
}

const { id, eyebrow, lines, lead, items, tone = 'ember' } = Astro.props;
const pad = (n: number) => String(n).padStart(2, '0');
---

<section class:list={['projects', `projects--${tone}`]} aria-labelledby={`${id}-title`} data-hscroll>
  <div class="head">
    <div data-reveal><p class="eyebrow">{eyebrow}</p></div>
    <SplitHeading id={`${id}-title`} class="h2" lines={lines} />
    <div data-reveal><p class="lead">{lead}</p></div>
  </div>

  <div class="viewport" data-hscroll-viewport>
    <ol class="track" data-hscroll-track>
      {items.map((p, i) => (
        <li class="item">
          <article class="card" data-project-card>
            <div class="photo">
              <Image src={p.image} alt={p.alt} widths={[360, 560, 840]} sizes="(max-width: 760px) 78vw, 400px" style={p.focus ? { objectPosition: p.focus } : undefined} data-hscroll-img />
            </div>
            <div class="shade" aria-hidden="true"></div>
            <div class="face">
              <span class="num">{pad(i + 1)}<span>/{pad(items.length)}</span></span>
              <h3>{p.title}</h3>
              <p class="meta">{p.meta}</p>
            </div>
            <div class="details" id={`${id}-d${i}`} data-project-details>
              <p class="d-title" aria-hidden="true">{p.title}</p>
              <p class="meta">{p.meta}</p>
              <p class="d-text">{p.text}</p>
            </div>
            <button type="button" class="toggle" aria-expanded="false" aria-controls={`${id}-d${i}`} data-project-toggle>
              <span class="visually-hidden">Read more about {p.title}</span>
              <span class="plus" aria-hidden="true"></span>
            </button>
          </article>
        </li>
      ))}
    </ol>
  </div>
  <div class="progress" aria-hidden="true"><span data-hscroll-progress></span></div>
</section>

<script>
  // Cards: click / tap (or Enter) toggles the description. Only one open per sequence.
  document.querySelectorAll<HTMLElement>('[data-project-card]').forEach((card) => {
    const btn = card.querySelector<HTMLButtonElement>('[data-project-toggle]');
    if (!btn) return;
    const set = (open: boolean) => {
      card.classList.toggle('is-open', open);
      btn.setAttribute('aria-expanded', String(open));
    };
    card.addEventListener('click', () => {
      const open = !card.classList.contains('is-open');
      card.closest('ol')?.querySelectorAll<HTMLElement>('[data-project-card].is-open').forEach((c) => {
        if (c !== card) {
          c.classList.remove('is-open');
          c.querySelector('[data-project-toggle]')?.setAttribute('aria-expanded', 'false');
        }
      });
      set(open);
    });
    card.addEventListener('keydown', (e) => { if (e.key === 'Escape') set(false); });
  });
</script>

<style>
  .projects { position: relative; padding: var(--section-y) 0 120px; overflow: hidden; }
  .projects--ember { background: linear-gradient(180deg, var(--ink) 0%, var(--ember-2) 50%, var(--ink) 100%); }
  .projects--deep {
    background: radial-gradient(50% 60% at 80% 30%, rgb(var(--orange-rgb) / 0.18), transparent 70%), var(--ink-deep);
  }
  .head { padding: 0 var(--gutter); display: flex; flex-direction: column; gap: 24px; max-width: 900px; margin-bottom: 56px; }
  .lead { max-width: 520px; }

  .viewport { overflow: hidden; }
  .track {
    display: flex; gap: clamp(20px, 2.6vw, 40px); align-items: flex-start;
    width: max-content; margin: 0; list-style: none;
    padding: 30px var(--gutter) 20px;
  }
  .item { width: clamp(260px, 27vw, 400px); flex: none; }
  .item:nth-child(even) { margin-top: 60px; }

  .card {
    position: relative; aspect-ratio: 3 / 4; overflow: hidden; cursor: pointer;
    box-shadow: var(--shadow-card);
    transition: transform 0.5s var(--ease-out), box-shadow 0.4s ease;
  }
  .photo { position: absolute; inset: 0; }
  .photo img {
    width: 100%; height: 100%; object-fit: cover; transform: scale(1.12); will-change: transform;
    transition: filter 0.5s ease;
  }
  .shade {
    position: absolute; inset: 0;
    background: linear-gradient(180deg, rgb(var(--ink-rgb) / 0.05) 35%, rgb(var(--ink-rgb) / 0.9) 100%);
    transition: background-color 0.5s ease;
  }
  .face {
    position: absolute; left: 0; right: 0; bottom: 0;
    padding: 24px 72px 24px 24px;
    display: flex; flex-direction: column; gap: 8px;
    transition: transform 0.55s var(--ease-out), opacity 0.3s ease;
  }
  .num { font: 700 20px/1 var(--font-display); color: var(--cream); }
  .num span { font-size: 12px; color: var(--amber); margin-left: 2px; }
  h3 { font-size: clamp(30px, 2.8vw, 44px); line-height: 0.95; text-transform: uppercase; }
  .meta { font: 600 11px/1.4 var(--font-body); letter-spacing: 0.18em; text-transform: uppercase; color: var(--amber); }

  .details {
    position: absolute; inset: 0;
    display: flex; flex-direction: column; gap: 10px;
    padding: 26px 24px 84px;
    overflow-y: auto; scrollbar-width: thin;
    opacity: 0; transform: translateY(16px);
    transition: opacity 0.4s ease, transform 0.5s var(--ease-out);
    pointer-events: none;
  }
  .d-title { font: 700 clamp(24px, 2.2vw, 32px)/0.95 var(--font-display); text-transform: uppercase; color: var(--cream); }
  .d-text { margin-top: 6px; font-size: 0.95rem; line-height: 1.6; color: var(--text-warm); }

  .toggle {
    position: absolute; right: 20px; bottom: 22px;
    width: 44px; height: 44px; border-radius: 50%;
    border: 1px solid var(--amber); background: rgb(var(--ink-rgb) / 0.55);
    cursor: pointer; transition: background-color 0.3s ease, transform 0.5s var(--ease-out);
  }
  .plus, .plus::after {
    position: absolute; left: 50%; top: 50%; width: 14px; height: 1.5px; margin: -0.75px 0 0 -7px;
    background: var(--cream); content: '';
  }
  .plus::after { left: 0; margin: -0.75px 0 0 0; transform: rotate(90deg); }

  /* hover: a subtle lift says "explore me" */
  @media (hover: hover) and (pointer: fine) {
    .card:hover { transform: translateY(-8px); box-shadow: 0 40px 80px rgb(0 0 0 / 0.65), 0 0 0 1px rgb(var(--amber-rgb) / 0.5), 0 0 60px rgb(var(--orange-rgb) / 0.22); }
    .card:hover .toggle { background: var(--orange); }
  }

  /* open */
  .card.is-open .shade { background-color: rgb(var(--ink-rgb) / 0.78); }
  .card.is-open .photo img { filter: blur(2px) brightness(0.7); }
  .card.is-open .face { opacity: 0; transform: translateY(16px); }
  .card.is-open .details { opacity: 1; transform: none; pointer-events: auto; }
  .card.is-open .toggle { transform: rotate(45deg); background: var(--orange); }

  .progress { position: relative; height: 1px; margin: 48px var(--gutter) 0; background: rgb(var(--cream-rgb) / 0.14); }
  .progress span {
    position: absolute; inset: 0; transform-origin: 0 50%; transform: scaleX(0);
    background: linear-gradient(90deg, var(--orange), var(--amber));
  }

  /* phones / tablets: native swipe instead of the pinned scroll */
  @media (max-width: 899px) {
    .viewport { overflow-x: auto; scroll-snap-type: x mandatory; scroll-padding-inline: 24px; scrollbar-width: none; }
    .viewport::-webkit-scrollbar { display: none; }
    .item { scroll-snap-align: start; width: 78vw; }
    .item:nth-child(even) { margin-top: 30px; }
    .track { padding-inline: 24px; }
    .progress { display: none; }
    .d-text { font-size: 0.9rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .card, .face, .details, .toggle { transition: none; }
    /* no pinned scroll: let people swipe / scroll the row instead */
    .viewport { overflow-x: auto; }
  }
</style>
