---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import SplitHeading from '../home/SplitHeading.astro';
import Spotlight from '../home/Spotlight.astro';
import soleil from '../../assets/about/collab/cirque-du-soleil.jpg';
import friedrichstadt from '../../assets/about/collab/friedrichstadt-palast.jpg';
import eloize from '../../assets/about/collab/cirque-eloize.jpg';
import sevenFingers from '../../assets/about/collab/the-7-fingers.jpg';
import knie from '../../assets/about/collab/circus-knie.jpg';
import sonrisas from '../../assets/about/collab/productores-de-sonrisas.jpg';
import flashday from '../../assets/about/collab/zircus-flashday.jpg';

interface Collab {
  name: string;
  image: ImageMetadata;
}

const collabs: Collab[] = [
  { name: 'Cirque du Soleil', image: soleil },
  { name: 'Friedrichstadt-Palast', image: friedrichstadt },
  { name: 'Cirque Éloize', image: eloize },
  { name: 'The 7 Fingers', image: sevenFingers },
  { name: 'Circus Knie', image: knie },
  { name: 'Productores de Sonrisas', image: sonrisas },
  { name: 'Zircus Flashday', image: flashday },
];
---

<section class="collabs" aria-labelledby="collabs-title" data-hover-reveal>
  <Spotlight size={700} strength={0.16} />
  <div class="head">
    <div data-reveal><p class="eyebrow">05 — Collaborations</p></div>
    <SplitHeading id="collabs-title" class="h2" lines={['Performed and', 'created with']} />
    <div data-reveal>
      <p class="lead">
        Over the years, we have performed and created around the world, collaborating with internationally recognised
        companies and productions.
      </p>
    </div>
  </div>

  <ul class="list" data-reveal>
    {collabs.map((c, i) => (
      <li class="row" data-hover-index={i}>
        <span class="idx">{String(i + 1).padStart(2, '0')}</span>
        <span class="thumb" aria-hidden="true"><Image src={c.image} alt="" width={160} /></span>
        <span class="name">{c.name}</span>
        <span class="arrow" aria-hidden="true">↗</span>
      </li>
    ))}
  </ul>

  <!-- floating preview that follows the mouse (desktop) -->
  <div class="preview" aria-hidden="true" data-hover-preview>
    {collabs.map((c) => (
      <Image src={c.image} alt="" widths={[360, 560]} sizes="360px" data-hover-img />
    ))}
  </div>
</section>

<style>
  .collabs {
    position: relative;
    padding: var(--section-y) var(--gutter);
    background: radial-gradient(50% 60% at 20% 30%, rgb(var(--orange-rgb) / 0.2), transparent 70%), var(--ink-deep);
  }
  .head { position: relative; display: flex; flex-direction: column; gap: 24px; max-width: 760px; margin-bottom: 56px; }
  .lead { max-width: 560px; }

  .list { position: relative; margin: 0; padding: 0; list-style: none; border-top: 1px solid rgb(var(--cream-rgb) / 0.14); }
  .row {
    display: grid; grid-template-columns: 60px auto 1fr auto; align-items: center; gap: 20px;
    padding: clamp(18px, 2.2vw, 30px) 0;
    border-bottom: 1px solid rgb(var(--cream-rgb) / 0.14);
    transition: color 0.3s ease;
  }
  .idx { font: 600 13px/1 var(--font-body); letter-spacing: 0.2em; color: var(--amber); }
  .thumb { display: none; width: 64px; height: 64px; overflow: hidden; }
  .thumb img { width: 100%; height: 100%; object-fit: cover; }
  .name {
    font: 700 clamp(34px, 6vw, 88px)/0.95 var(--font-display); text-transform: uppercase;
    transition: transform 0.5s var(--ease-out), color 0.3s ease;
  }
  .arrow { font-size: 28px; color: var(--amber); opacity: 0; transform: translate(-10px, 10px); transition: opacity 0.3s ease, transform 0.4s var(--ease-out); }
  .row:hover .name { transform: translateX(24px); color: var(--amber); }
  .row:hover .arrow { opacity: 1; transform: none; }
  .list:hover .row:not(:hover) .name { color: rgb(var(--cream-rgb) / 0.35); }

  .preview {
    position: fixed; left: 0; top: 0; z-index: 30; pointer-events: none;
    width: 320px; aspect-ratio: 4 / 5; margin: -200px 0 0 -160px;
    overflow: hidden; opacity: 0; transform: scale(0.8);
    box-shadow: 0 30px 80px rgb(0 0 0 / 0.6), 0 0 0 1px rgb(var(--amber-rgb) / 0.3);
  }
  .preview img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0; transition: opacity 0.3s ease; }
  .preview img.is-active { opacity: 1; }

  /* touch screens: small inline photos instead of the floating preview */
  @media (hover: none), (pointer: coarse) {
    .thumb { display: block; }
    .preview { display: none; }
    .row { grid-template-columns: 40px auto 1fr; }
    .arrow { display: none; }
  }
</style>
