---
import { Image } from 'astro:assets';
import SplitHeading from '../home/SplitHeading.astro';
import Spotlight from '../home/Spotlight.astro';
import { founders } from '../../data/about';
---

<section class="founders" aria-labelledby="about-founders-title">
  <div class="glow glow--f" data-parallax="-100" style="--breathe: 11s"><span></span></div>
  <Spotlight size={760} strength={0.16} />

  <div class="head">
    <div data-reveal><p class="eyebrow">04 — Founders</p></div>
    <SplitHeading id="about-founders-title" class="h2" lines={['The people behind', 'Arte Algo']} />
  </div>

  <div class="people">
    {founders.map((f, i) => (
      <article class="person" data-reveal>
        <div class="portrait-col">
          <div class="portrait" data-tilt data-tilt-max="4">
            <Image src={f.photo} alt={`Portrait of ${f.name}`} widths={[420, 640, 960]} sizes="(max-width: 900px) min(420px, 86vw), 480px" />
          </div>
        </div>
        <div class="bio">
          <p class="index" aria-hidden="true">{String(i + 1).padStart(2, '0')}<span>/{String(founders.length).padStart(2, '0')}</span></p>
          <h3>{f.name}</h3>
          <p class="role">{f.role}</p>
          <div class="text">
            {f.bio.map((p) => <p>{p}</p>)}
          </div>
          <button type="button" class="line-link cv-link" data-cv-open={f.id} aria-haspopup="dialog">View selected CV</button>
        </div>
      </article>
    ))}
  </div>

  <!-- outside the revealed blocks so GSAP's hidden state can't hide an open dialog -->
  {founders.map((f) => (
    <dialog class="cv" data-cv={f.id} aria-labelledby={`cv-${f.id}-title`}>
      <form method="dialog"><button class="close" aria-label="Close">×</button></form>
      <p class="eyebrow">Selected CV</p>
      <h3 id={`cv-${f.id}-title`}>{f.name}</h3>
      <div class="groups">
        {f.cv.map((g) => (
          <div class="group">
            <h4>{g.label}</h4>
            <ul>{g.items.map((it) => <li>{it}</li>)}</ul>
          </div>
        ))}
      </div>
    </dialog>
  ))}
</section>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-cv-open]').forEach((btn) => {
    const dialog = document.querySelector<HTMLDialogElement>(`[data-cv="${btn.dataset.cvOpen}"]`);
    if (!dialog) return;
    btn.addEventListener('click', () => dialog.showModal());
    // click on the backdrop closes
    dialog.addEventListener('click', (e) => { if (e.target === dialog) dialog.close(); });
  });
</script>

<style>
  .founders {
    position: relative;
    padding: var(--section-y) var(--gutter);
    background:
      radial-gradient(55% 70% at 25% 40%, rgb(var(--orange-rgb) / 0.32), transparent 70%),
      linear-gradient(180deg, var(--ink) 0%, var(--ember-3) 40%, var(--ember-3) 80%, var(--ink) 100%);
  }
  .glow--f { left: 10%; top: 80px; width: 760px; height: 760px; }
  .glow--f span { background: radial-gradient(circle, rgb(var(--amber-rgb) / 0.22), transparent 62%); }

  .head, .people { position: relative; max-width: 1180px; margin-inline: auto; }
  .head { display: flex; flex-direction: column; gap: 24px; margin-bottom: clamp(64px, 8vw, 120px); }
  .head .eyebrow { color: var(--peach); }

  /* one founder per row, alternating sides; the portrait stays in view while the bio scrolls past */
  .people { display: grid; gap: clamp(96px, 11vw, 168px); }
  .person {
    display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    gap: clamp(40px, 7vw, 120px); align-items: start;
  }
  .person:nth-child(even) { grid-template-columns: minmax(0, 6fr) minmax(0, 5fr); }
  .person:nth-child(even) .portrait-col { order: 2; }
  .portrait-col { position: sticky; top: 120px; }

  .portrait {
    aspect-ratio: 4 / 5; overflow: hidden;
    background:
      radial-gradient(70% 60% at 50% 35%, rgb(var(--orange-rgb) / 0.35), transparent 70%),
      linear-gradient(180deg, var(--ember-4), var(--ink));
    box-shadow: var(--shadow-card);
  }
  .portrait img { width: 100%; height: 100%; object-fit: cover; object-position: 50% 0; }

  .portrait::after {
    content: ''; position: absolute; inset: 0; pointer-events: none;
    box-shadow: inset 0 0 0 1px rgb(var(--amber-rgb) / 0.22);
  }
  .portrait { position: relative; }

  .bio { display: flex; flex-direction: column; gap: 12px; max-width: 560px; padding-top: clamp(8px, 3vw, 48px); }
  .index { font: 700 22px/1 var(--font-display); color: var(--cream); margin-bottom: 6px; }
  .index span { font-size: 13px; color: var(--amber); margin-left: 2px; }
  h3 { font-size: clamp(48px, 5.4vw, 84px); line-height: 0.92; text-transform: uppercase; }
  .role { font: 600 11px/1.4 var(--font-body); letter-spacing: 0.18em; text-transform: uppercase; color: var(--amber); }
  .text {
    margin-top: 22px; padding-top: 26px; box-shadow: inset 0 1px 0 rgb(var(--cream-rgb) / 0.14);
    display: flex; flex-direction: column; gap: 1em; color: var(--text); line-height: 1.7; font-size: 1.04rem;
  }
  .text p:first-child { font-size: 1.18rem; line-height: 1.6; color: var(--cream); }
  .cv-link { margin-top: 26px; align-self: flex-start; padding: 0; border: 0; background: none; color: var(--cream); cursor: pointer; }
  .cv-link:hover { color: var(--amber); }

  .cv {
    width: min(640px, calc(100vw - 32px)); max-height: 86vh;
    padding: clamp(28px, 4vw, 48px); border: 0;
    background: var(--ink-card); color: var(--cream);
    box-shadow: var(--shadow-card);
  }
  .cv::backdrop { background: rgb(var(--ink-rgb) / 0.88); }
  .cv h3 { margin: 10px 0 28px; }
  .groups { display: grid; gap: 26px; }
  h4 { font: 600 12px/1.4 var(--font-body); letter-spacing: 0.2em; text-transform: uppercase; color: var(--amber); margin-bottom: 10px; }
  .group ul { margin: 0; padding: 0; list-style: none; display: grid; gap: 6px; }
  .group li { position: relative; padding-left: 18px; line-height: 1.5; color: var(--text); }
  .group li::before { content: ''; position: absolute; left: 0; top: 0.7em; width: 8px; height: 1px; background: var(--orange); }
  .close {
    position: absolute; top: 14px; right: 14px;
    width: 44px; height: 44px; border-radius: 50%;
    border: 1px solid var(--amber); background: transparent; color: var(--cream);
    font: 400 26px/1 var(--font-body); cursor: pointer;
    transition: background-color 0.2s ease, color 0.2s ease;
  }
  .close:hover { background: var(--orange); color: var(--ink); }

  @media (max-width: 900px) {
    .person, .person:nth-child(even) { grid-template-columns: 1fr; gap: 32px; }
    .person:nth-child(even) .portrait-col { order: 0; }
    .portrait-col { position: static; width: min(420px, 100%); }
    .bio { padding-top: 0; }
    .text p:first-child { font-size: 1.08rem; }
  }
</style>
