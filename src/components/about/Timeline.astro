---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import SplitHeading from '../home/SplitHeading.astro';
import cabaret from '../../assets/media/cabaret-la-central-del-circ-2017.jpg';
import soleil from '../../assets/media/cirque-du-soleil-2017-2019-2.jpg';
import oneDrop from '../../assets/media/one-night-for-one-drop-cirque-du-soleil-2019-2.jpg';
import latina from '../../assets/media/festival-internacional-la-latina-2021.jpg';
import roncalli from '../../assets/media/roncalli-apollo-variete-2021-22.jpg';
import knie from '../../assets/media/circus-knie-2022-3.jpg';
import tuSiQueVales from '../../assets/media/tu-si-que-vales-italy-2022.jpg';
import rockCircus from '../../assets/media/rock-circus-2023.jpg';
import sevenFingers from '../../assets/media/the7fingers-duel-reality-2023-24-2.jpg';
import heilbronn from '../../assets/media/heilbronn-2024-25-3.jpg';
import gotTalent from '../../assets/media/got-talent-france-2025.jpg';
import friedrichstadt from '../../assets/media/friedrichstadt-palast-2025-27-2.jpg';
import flashday from '../../assets/media/zircus-flashday-2026-2.jpg';
import eloize from '../../assets/media/cirque-eloize-id-evolution-2026-27-2.jpg';

interface Milestone {
  year: string;
  /** Production title as written in the client's photo library. */
  title: string;
  image: ImageMetadata;
}

const milestones: Milestone[] = [
  { year: '2017', title: 'Cabaret La Central del Circ', image: cabaret },
  { year: '2017–19', title: 'Cirque du Soleil', image: soleil },
  { year: '2019', title: 'One Night for One Drop | Cirque du Soleil', image: oneDrop },
  { year: '2021', title: 'Festival Internacional La Latina', image: latina },
  { year: '2021/22', title: 'Roncalli | Apollo Varieté', image: roncalli },
  { year: '2022', title: 'Circus Knie', image: knie },
  { year: '2022', title: 'Tu Si Que Vales | Italy', image: tuSiQueVales },
  { year: '2023', title: 'Rock Circus', image: rockCircus },
  { year: '2023/24', title: 'The 7 Fingers | Duel Reality', image: sevenFingers },
  { year: '2024/25', title: 'Heilbronn', image: heilbronn },
  { year: '2025', title: 'Got Talent France', image: gotTalent },
  { year: '2025–27', title: 'Friedrichstadt-Palast', image: friedrichstadt },
  { year: '2026', title: 'Zircus Flashday', image: flashday },
  { year: '2026/27', title: 'Cirque Éloize | ID Evolution', image: eloize },
];
---

<section class="timeline" aria-labelledby="timeline-title" data-hscroll>
  <div class="head">
    <div data-reveal><p class="eyebrow">02 — Our path</p></div>
    <SplitHeading id="timeline-title" class="h2" lines={['From a duo', 'to a company']} />
    <div data-reveal><p class="lead">What began in 2017 as a teeterboard duo has grown into an international creative company.</p></div>
  </div>

  <div class="viewport" data-hscroll-viewport>
    <ol class="track" data-hscroll-track>
      {milestones.map((m, i) => (
        <li class="item" style={`--tilt: ${i % 2 ? 1 : -1}`}>
          <span class="year" aria-hidden="true">{m.year}</span>
          <div class="photo">
            <Image src={m.image} alt={`${m.title}, ${m.year}`} widths={[360, 560, 840]} sizes="(max-width: 760px) 72vw, 380px" data-hscroll-img />
          </div>
          <p class="meta"><span class="y">{m.year}</span>{m.title}</p>
        </li>
      ))}
    </ol>
  </div>
  <div class="progress" aria-hidden="true"><span data-hscroll-progress></span></div>
</section>

<style>
  .timeline {
    position: relative;
    padding: var(--section-y) 0 120px;
    background: linear-gradient(180deg, var(--ink) 0%, var(--ember-2) 50%, var(--ink) 100%);
    overflow: hidden;
  }
  .head { padding: 0 var(--gutter); display: flex; flex-direction: column; gap: 24px; max-width: 900px; margin-bottom: 64px; }
  .lead { max-width: 520px; }

  .viewport { overflow: hidden; }
  .track {
    display: flex; gap: clamp(28px, 4vw, 64px); align-items: flex-start;
    width: max-content; margin: 0; list-style: none;
    padding: 40px var(--gutter) 20px;
  }
  .item { position: relative; width: clamp(240px, 26vw, 380px); flex: none; }
  .item:nth-child(even) { margin-top: 90px; }
  .year {
    position: absolute; left: -12px; top: -54px; z-index: 0;
    font: 700 clamp(64px, 8vw, 120px)/1 var(--font-display);
    color: transparent; -webkit-text-stroke: 1px rgb(var(--amber-rgb) / 0.35);
    white-space: nowrap; pointer-events: none;
  }
  .photo {
    position: relative; z-index: 1;
    aspect-ratio: 4 / 5; overflow: hidden;
    box-shadow: 0 30px 70px rgb(0 0 0 / 0.6), 0 0 0 1px rgb(var(--amber-rgb) / 0.15);
  }
  .photo img { width: 100%; height: 100%; object-fit: cover; transform: scale(1.08); will-change: transform; }
  .meta {
    position: relative; z-index: 1;
    display: flex; flex-direction: column; gap: 6px; margin-top: 18px;
    font: 600 13px/1.4 var(--font-body); letter-spacing: 0.16em; text-transform: uppercase;
  }
  .meta .y { font: 700 28px/1 var(--font-display); letter-spacing: 0.02em; color: var(--amber); }

  .progress { position: relative; height: 1px; margin: 48px var(--gutter) 0; background: rgb(var(--cream-rgb) / 0.14); }
  .progress span {
    position: absolute; inset: 0; transform-origin: 0 50%; transform: scaleX(0);
    background: linear-gradient(90deg, var(--orange), var(--amber));
  }

  /* phones / tablets: native swipe instead of the pinned scroll */
  @media (max-width: 899px) {
    .viewport { overflow-x: auto; scroll-snap-type: x mandatory; scroll-padding-inline: 24px; scrollbar-width: none; }
    .viewport::-webkit-scrollbar { display: none; }
    .item { scroll-snap-align: start; width: 72vw; }
    .item:nth-child(even) { margin-top: 40px; }
    .track { padding-inline: 24px; }
    .progress { display: none; }
  }
</style>
