---
interface Props {
  src: string;
  poster: string;
  title: string;
  /** CSS aspect-ratio, e.g. "16 / 9" or "9 / 16". */
  ratio?: string;
  class?: string;
}

const { src, poster, title, ratio = '16 / 9', class: className } = Astro.props;
---

<figure class:list={['player', className]} style={`aspect-ratio: ${ratio}`} data-player data-cursor="Play">
  <video src={src} poster={poster} preload="none" playsinline aria-label={title}></video>
  <button type="button" class="play" data-player-btn aria-label={`Play video: ${title}`}>
    <span class="ring" aria-hidden="true">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M7 4l13 8-13 8z"></path></svg>
    </span>
    <span class="label">{title}</span>
  </button>
</figure>

<style>
  .player {
    position: relative; margin: 0; overflow: hidden; background: #000;
    box-shadow: var(--shadow-photo);
  }
  video { width: 100%; height: 100%; object-fit: cover; display: block; }
  .play {
    position: absolute; inset: 0;
    display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 18px;
    border: 0; padding: 24px; cursor: pointer; color: var(--cream);
    background: radial-gradient(circle at 50% 50%, rgb(var(--ink-rgb) / 0.15), rgb(var(--ink-rgb) / 0.6));
    transition: opacity 0.4s ease;
  }
  .ring {
    width: 84px; height: 84px; border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    border: 1px solid var(--amber); background: rgb(var(--ink-rgb) / 0.55); color: var(--amber);
    transition: transform 0.4s var(--ease-out), background-color 0.3s ease, color 0.3s ease;
  }
  .ring svg { margin-left: 4px; }
  .play:hover .ring { transform: scale(1.1); background: var(--orange); color: var(--ink); }
  .label {
    font: 600 12px/1.4 var(--font-body); letter-spacing: 0.22em; text-transform: uppercase; text-align: center;
    text-shadow: 0 1px 8px rgb(0 0 0 / 0.8);
  }
  .player.is-playing .play { opacity: 0; pointer-events: none; }
</style>
