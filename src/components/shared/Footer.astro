---
import { Image } from 'astro:assets';
import logo from '../../assets/brand/logo-white.png';
import { navLeft, navRight, site } from '../../data/site';
import InstagramIcon from './InstagramIcon.astro';
import LangSwitch from './LangSwitch.astro';

const allNav = [...navLeft, ...navRight];
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="top">
    <a href="/" aria-label={`${site.name} — home`}>
      <Image src={logo} alt="" width={208} densities={[1, 2]} class="logo" />
    </a>
    <nav aria-label="Footer">
      {allNav.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>
    <div class="contact">
      <a href={`mailto:${site.email}`}>{site.email}</a>
      <span>{site.location}</span>
    </div>
  </div>
  <div class="bottom">
    <span>© {year} {site.name}</span>
    <div class="tools">
      <LangSwitch />
      <a href={site.instagram} aria-label="Arte Algo on Instagram" target="_blank" rel="noopener"><InstagramIcon /></a>
    </div>
  </div>
</footer>

<style>
  .footer {
    position: relative;
    padding: 80px var(--gutter) 48px;
    background: var(--ink);
    display: flex; flex-direction: column; gap: 56px;
  }
  .top { display: grid; grid-template-columns: auto 1fr auto; gap: 80px; align-items: center; }
  .logo { width: 104px; height: auto; }
  nav {
    display: flex; flex-wrap: wrap; gap: 40px; justify-content: center;
    font: 500 13px/1 var(--font-body); letter-spacing: 0.18em; text-transform: uppercase;
  }
  .contact {
    display: flex; flex-direction: column; gap: 12px; align-items: flex-end;
    font: 400 15px/1.4 var(--font-body); color: var(--text-soft);
  }
  .contact a { color: inherit; }
  .bottom {
    display: flex; justify-content: space-between; align-items: center;
    padding-top: 28px; border-top: 1px solid rgb(var(--cream-rgb) / 0.14);
    font: 400 13px/1 var(--font-body); color: var(--muted);
  }
  .tools { display: flex; align-items: center; gap: 24px; }
  .tools a { display: flex; }

  @media (max-width: 1080px) {
    .top { grid-template-columns: 1fr; justify-items: center; gap: 32px; text-align: center; }
    .contact { align-items: center; }
  }
  @media (max-width: 760px) {
    .footer { padding: 56px 24px 36px; gap: 32px; }
    .logo { width: 84px; }
    nav { display: grid; grid-template-columns: 1fr 1fr; gap: 4px 24px; font-size: 12px; letter-spacing: 0.16em; }
    nav a { padding: 14px 0; }
    .bottom { flex-direction: column-reverse; gap: 24px; }
  }
</style>
