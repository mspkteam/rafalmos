---
import { Image } from 'astro:assets';
import logo from '../../assets/brand/logo-white.png';
import { navLeft, navRight, site } from '../../data/site';
import InstagramIcon from './InstagramIcon.astro';
import LangSwitch from './LangSwitch.astro';

interface Props {
  current?: string;
}

const { current = '/' } = Astro.props;
const allNav = [...navLeft, ...navRight];
const trim = (p: string) => (p.length > 1 ? p.replace(/\/+$/, '') : p);
const isCurrent = (href: string) => (trim(href) === trim(current) ? 'page' : undefined);
---

<header class="header" data-header>
  <button class="burger" type="button" aria-expanded="false" aria-controls="mobile-menu" data-menu-toggle>
    <span></span><span></span><span></span>
    <span class="visually-hidden">Menu</span>
  </button>

  <nav class="nav nav--left" aria-label="Primary">
    {navLeft.map((item) => (
      <a href={item.href} aria-current={isCurrent(item.href)}>{item.label}</a>
    ))}
  </nav>

  <a href="/" class="logo" aria-label={`${site.name} — home`}>
    <Image src={logo} alt="" width={168} densities={[1, 2]} loading="eager" />
  </a>

  <div class="right">
    <nav class="nav" aria-label="Secondary">
      {navRight.map((item) => <a href={item.href} aria-current={isCurrent(item.href)}>{item.label}</a>)}
    </nav>
    <div class="tools">
      <LangSwitch />
      <a href={site.instagram} class="ig" aria-label="Arte Algo on Instagram" target="_blank" rel="noopener">
        <InstagramIcon />
      </a>
    </div>
  </div>
</header>

<div class="menu" id="mobile-menu" hidden data-menu>
  <nav aria-label="Mobile">
    {allNav.map((item) => <a href={item.href} aria-current={isCurrent(item.href)}>{item.label}</a>)}
  </nav>
</div>

<style>
  .header {
    position: fixed; inset: 0 0 auto; z-index: 50;
    height: var(--header-h);
    display: grid; grid-template-columns: 1fr auto 1fr; align-items: center;
    padding: 0 56px;
    background: linear-gradient(180deg, rgb(var(--ink-rgb) / 0.55), rgb(var(--ink-rgb) / 0));
    transition: height 0.3s ease, background-color 0.3s ease;
  }
  .header::before {
    content: ''; position: absolute; inset: 0; z-index: -1;
    background: var(--ink); opacity: 0; transition: opacity 0.3s ease;
  }
  .header.is-solid { --header-h: 80px; }
  .header.is-solid::before { opacity: 1; }

  .nav, .right {
    display: flex; align-items: center; gap: 40px;
    font: 500 13px/1 var(--font-body); letter-spacing: 0.18em; text-transform: uppercase;
    text-shadow: var(--text-shadow-nav);
  }
  .right { justify-content: flex-end; }
  .nav a { padding: 6px 0; border-bottom: 1px solid transparent; }
  .nav a[aria-current='page'] { border-bottom-color: var(--orange); }

  .tools {
    display: flex; align-items: center; gap: 20px;
    padding-left: 28px; border-left: 1px solid rgb(var(--cream-rgb) / 0.3);
  }
  .ig { display: flex; padding: 4px; }

  .logo img {
    width: 84px; height: auto;
    filter: drop-shadow(0 2px 6px rgb(0 0 0 / 0.7));
    transition: width 0.3s ease;
  }
  .header.is-solid .logo img { width: 64px; }

  .burger { display: none; }

  .menu {
    position: fixed; inset: 0; z-index: 45;
    background: rgb(var(--ink-rgb) / 0.97);
    display: flex; align-items: center; justify-content: center;
  }
  .menu[hidden] { display: none; }
  .menu nav { display: flex; flex-direction: column; align-items: center; gap: 8px; }
  .menu a {
    padding: 12px 0;
    font: 700 44px/1 var(--font-display); text-transform: uppercase;
  }
  .menu a[aria-current='page'] { color: var(--amber); }

  @media (max-width: 1080px) {
    .header { padding: 0 32px; }
    .nav, .right { gap: 24px; }
  }

  @media (max-width: 900px) {
    .header { padding: 0 20px; }
    .nav { display: none; }
    .tools { padding-left: 0; border-left: 0; gap: 14px; font-size: 12px; letter-spacing: 0.14em; }
    .logo img, .header.is-solid .logo img { width: 56px; }
    .burger {
      display: flex; flex-direction: column; justify-content: center; gap: 6px;
      width: 44px; height: 44px; padding: 0; background: none; border: 0; cursor: pointer;
      filter: drop-shadow(0 1px 3px rgb(0 0 0 / 0.8));
    }
    .burger span:not(.visually-hidden) {
      display: block; width: 24px; height: 1.5px; background: var(--cream);
      transition: transform 0.25s ease, opacity 0.25s ease, width 0.25s ease;
    }
    .burger span:nth-child(3) { width: 16px; }
    .burger[aria-expanded='true'] span:nth-child(1) { transform: translateY(7.5px) rotate(45deg); }
    .burger[aria-expanded='true'] span:nth-child(2) { opacity: 0; }
    .burger[aria-expanded='true'] span:nth-child(3) { width: 24px; transform: translateY(-7.5px) rotate(-45deg); }
  }
</style>
