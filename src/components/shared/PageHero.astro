---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import SplitHeading from '../home/SplitHeading.astro';
import Spotlight from '../home/Spotlight.astro';

interface Props {
  eyebrow: string;
  /** Title, one string per line. */
  lines: string[];
  image?: ImageMetadata;
  imageAlt?: string;
  /** Focal point of the background image (CSS object-position). */
  focus?: string;
  /** Short hero: no full-screen height. */
  compact?: boolean;
}

const { eyebrow, lines, image, imageAlt = '', focus = '50% 50%', compact = false } = Astro.props;
---

<section class:list={['page-hero', { 'page-hero--compact': compact, 'page-hero--plain': !image }]} aria-labelledby="page-title" data-mouse-zone>
  {image && (
    <div class="bg" data-hero-bg>
      <Image src={image} alt={imageAlt} widths={[800, 1400, 2000]} sizes="100vw" loading="eager" fetchpriority="high" style={{ objectPosition: focus }} />
    </div>
  )}
  <div class="light" aria-hidden="true"></div>
  <Spotlight size={900} strength={0.24} />

  <div class="copy" data-depth="-10">
    <div data-reveal><p class="eyebrow">{eyebrow}</p></div>
    <SplitHeading as="h1" id="page-title" class="title" lines={lines} />
    {Astro.slots.has('default') && <div class="intro" data-reveal><div><slot /></div></div>}
  </div>

  <slot name="extra" />
</section>

<style>
  .page-hero {
    position: relative;
    min-height: max(620px, min(92svh, 860px));
    display: flex; align-items: flex-end;
    padding: calc(var(--header-h) + 60px) var(--gutter) clamp(80px, 10vw, 140px);
  }
  .page-hero--compact { min-height: max(520px, min(70svh, 680px)); }
  .page-hero--plain {
    background:
      radial-gradient(55% 60% at 80% 30%, rgb(var(--orange-rgb) / 0.32), transparent 70%),
      radial-gradient(40% 50% at 10% 80%, rgb(var(--amber-rgb) / 0.14), transparent 70%),
      var(--ink);
  }
  .bg { position: absolute; inset: 0; overflow: hidden; }
  .bg img { width: 100%; height: 115%; object-fit: cover; will-change: transform; }
  .light {
    position: absolute; inset: 0; pointer-events: none;
    background:
      radial-gradient(60% 55% at 78% 20%, rgb(var(--amber-rgb) / 0.28), transparent 70%),
      linear-gradient(180deg, rgb(var(--ink-rgb) / 0.55) 0%, rgb(var(--ink-rgb) / 0.2) 40%, rgb(var(--ink-rgb) / 0.8) 82%, var(--ink) 100%);
  }
  .page-hero--plain .light { background: linear-gradient(180deg, transparent 70%, var(--ink)); }

  .copy { position: relative; z-index: 2; display: flex; flex-direction: column; gap: 22px; max-width: 980px; }
  .copy .eyebrow { text-shadow: 0 1px 8px rgb(0 0 0 / 0.7); }
  .copy :global(.title) {
    font-size: clamp(3.25rem, 8.4vw, 8rem); line-height: 0.9; letter-spacing: -0.005em;
    text-shadow: 0 4px 40px rgb(0 0 0 / 0.55);
  }
  .intro { max-width: 620px; }
  .intro :global(p) { font-size: clamp(1.05rem, 0.98rem + 0.3vw, 1.25rem); line-height: 1.6; color: var(--text); }
  .intro :global(p + p) { margin-top: 0.8em; }

  @media (max-width: 760px) {
    .page-hero { padding-bottom: 72px; }
    .copy { gap: 16px; }
  }
</style>
