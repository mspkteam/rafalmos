---
// One per page. Any <button data-lightbox-src="…" data-lightbox-caption="…"> opens it (see motion.ts);
// arrows browse the visible buttons on the page.
---

<dialog class="lightbox" data-lightbox aria-label="Media viewer">
  <form method="dialog"><button class="close" aria-label="Close">×</button></form>
  <button type="button" class="nav nav--prev" data-lightbox-prev aria-label="Previous photo">←</button>
  <button type="button" class="nav nav--next" data-lightbox-next aria-label="Next photo">→</button>
  <figure>
    <img src="" alt="" data-lightbox-img />
    <figcaption><span data-lightbox-cap></span><span class="count" data-lightbox-count></span></figcaption>
  </figure>
</dialog>

<style>
  .lightbox {
    max-width: min(92vw, 1400px); max-height: 92vh;
    padding: 0; border: 0; background: transparent; color: var(--cream); overflow: visible;
  }
  .lightbox::backdrop { background: rgb(var(--ink-rgb) / 0.94); }
  figure { margin: 0; display: flex; flex-direction: column; gap: 14px; }
  img { max-width: 100%; max-height: calc(92vh - 56px); width: auto; height: auto; margin: 0 auto; box-shadow: 0 30px 90px rgb(0 0 0 / 0.7); }
  figcaption {
    display: flex; justify-content: center; gap: 18px; flex-wrap: wrap;
    color: var(--text-soft);
    font: 500 12px/1.4 var(--font-body); letter-spacing: 0.2em; text-transform: uppercase;
  }
  .count { color: var(--amber); }
  .close, .nav {
    position: fixed; z-index: 2;
    width: 48px; height: 48px; border-radius: 50%;
    border: 1px solid var(--amber); background: rgb(var(--ink-rgb) / 0.7); color: var(--cream);
    font: 400 22px/1 var(--font-body); cursor: pointer;
    transition: background-color 0.2s ease, color 0.2s ease;
  }
  .close { top: 16px; right: 16px; font-size: 28px; }
  .nav { top: 50%; margin-top: -24px; }
  .nav--prev { left: 16px; }
  .nav--next { right: 16px; }
  .nav[hidden] { display: none; }
  .close:hover, .nav:hover { background: var(--orange); color: var(--ink); }

  @media (max-width: 760px) {
    .nav { top: auto; bottom: 16px; margin-top: 0; }
  }
</style>
