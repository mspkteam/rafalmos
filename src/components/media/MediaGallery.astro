---
import { Image, getImage } from 'astro:assets';
import SplitHeading from '../home/SplitHeading.astro';
import { mediaPhotos, type MediaCategory } from '../../data/media';

const filters: { key: 'all' | MediaCategory; label: string }[] = [
  { key: 'all', label: 'All' },
  { key: 'stage', label: 'Stage' },
  { key: 'tv', label: 'TV' },
  { key: 'photoshoot', label: 'Photoshoots' },
];
const count = (key: string) => (key === 'all' ? mediaPhotos.length : mediaPhotos.filter((p) => p.category === key).length);

const items = await Promise.all(
  mediaPhotos.map(async (p) => {
    const ratio = p.image.width / p.image.height;
    const shape = ratio > 1.45 ? 'wide' : ratio < 0.85 ? 'tall' : 'square';
    const full = await getImage({ src: p.image, width: Math.min(1800, p.image.width), format: 'webp' });
    return { ...p, shape, full: full.src };
  }),
);
---

<section class="gallery" aria-labelledby="gallery-title" data-filter-gallery>
  <div class="head">
    <div>
      <div data-reveal><p class="eyebrow">Photos</p></div>
      <SplitHeading id="gallery-title" class="h2" lines={['On stage,', 'on screen']} />
    </div>
    <div class="filters" role="group" aria-label="Filter photos" data-reveal>
      {filters.map((f, i) => (
        <button type="button" class:list={['chip', { 'is-active': i === 0 }]} data-filter={f.key} aria-pressed={i === 0 ? 'true' : 'false'}>
          {f.label} <span>{count(f.key)}</span>
        </button>
      ))}
    </div>
  </div>

  <ul class="grid" data-batch>
    {items.map((p) => (
      <li class:list={['tile', `tile--${p.shape}`]} data-category={p.category}>
        <button type="button" class="open" data-lightbox-src={p.full} data-lightbox-caption={p.title || 'Arte Algo'} data-cursor="View">
          <Image src={p.image} alt={p.title ? `Arte Algo — ${p.title}` : 'Arte Algo'} widths={[360, 600, 900]} sizes="(max-width: 760px) 50vw, (max-width: 1200px) 33vw, 25vw" />
          {p.title && <span class="cap">{p.title}</span>}
        </button>
      </li>
    ))}
  </ul>
</section>

<style>
  .gallery { position: relative; padding: 120px var(--gutter) var(--section-y); background: var(--ink); }
  .head { display: flex; justify-content: space-between; align-items: flex-end; gap: 32px; flex-wrap: wrap; margin-bottom: 56px; }
  .head > div:first-child { display: flex; flex-direction: column; gap: 24px; }

  .filters { display: flex; flex-wrap: wrap; gap: 10px; }
  .chip {
    display: inline-flex; align-items: center; gap: 10px;
    height: 44px; padding: 0 20px; border-radius: 999px;
    border: 1px solid rgb(var(--cream-rgb) / 0.25); background: transparent; color: var(--cream);
    font: 600 12px/1 var(--font-body); letter-spacing: 0.18em; text-transform: uppercase; cursor: pointer;
    transition: background-color 0.25s ease, border-color 0.25s ease, color 0.25s ease;
  }
  .chip span { color: var(--amber); font-size: 11px; }
  .chip:hover { border-color: var(--amber); }
  .chip.is-active { background: var(--orange); border-color: var(--orange); color: var(--ink); }
  .chip.is-active span { color: var(--ink); }

  .grid {
    display: grid; grid-template-columns: repeat(4, 1fr); grid-auto-rows: clamp(160px, 17vw, 250px); grid-auto-flow: dense;
    gap: clamp(10px, 1.4vw, 20px); margin: 0; padding: 0; list-style: none;
  }
  .tile { position: relative; overflow: hidden; }
  .tile--tall { grid-row: span 2; }
  .tile--wide { grid-column: span 2; }
  .tile[hidden] { display: none; }
  .open { display: block; width: 100%; height: 100%; padding: 0; border: 0; background: #000; cursor: pointer; position: relative; }
  .open img { width: 100%; height: 100%; object-fit: cover; filter: brightness(0.88); transition: transform 0.8s var(--ease-out), filter 0.4s ease; }
  .open:hover img, .open:focus-visible img { transform: scale(1.05); filter: brightness(1.05); }
  .cap {
    position: absolute; left: 0; right: 0; bottom: 0;
    padding: 40px 16px 14px; text-align: left;
    background: linear-gradient(180deg, transparent, rgb(var(--ink-rgb) / 0.88));
    font: 600 11px/1.4 var(--font-body); letter-spacing: 0.16em; text-transform: uppercase; color: var(--cream);
    transform: translateY(8px); opacity: 0.85;
    transition: transform 0.4s var(--ease-out), opacity 0.3s ease;
  }
  .open:hover .cap { transform: none; opacity: 1; }

  @media (max-width: 1200px) { .grid { grid-template-columns: repeat(3, 1fr); } }
  @media (max-width: 760px) {
    .gallery { padding-top: 80px; }
    .grid { grid-template-columns: repeat(2, 1fr); grid-auto-rows: 42vw; }
    .tile--wide { grid-column: span 2; }
    .cap { font-size: 9px; letter-spacing: 0.1em; padding: 28px 10px 9px; }
  }
</style>
