---
import SplitHeading from '../home/SplitHeading.astro';
import VideoPlayer from '../shared/VideoPlayer.astro';
---

<section class="videos" aria-labelledby="videos-title">
  <div class="head">
    <div data-reveal><p class="eyebrow">Videos</p></div>
    <SplitHeading id="videos-title" class="h2" lines={['In motion']} />
  </div>
  <div class="row">
    <div class="main" data-reveal>
      <VideoPlayer src="/video/teaser-full.mp4" poster="/video/teaser-poster.jpg" title="Arte Algo — Teaser" />
    </div>
    <div class="side" data-reveal>
      <VideoPlayer src="/video/merchandise.mp4" poster="/video/merchandise-poster.jpg" title="Photoshoot — Arte Algo — Merchandise" ratio="9 / 16" />
    </div>
  </div>
</section>

<style>
  .videos {
    position: relative;
    padding: var(--section-y) var(--gutter);
    background: radial-gradient(50% 60% at 30% 40%, rgb(var(--orange-rgb) / 0.2), transparent 70%), var(--ink-deep);
  }
  .head { display: flex; flex-direction: column; gap: 24px; margin-bottom: 56px; }
  .row { display: grid; grid-template-columns: 1fr minmax(240px, 30%); gap: clamp(20px, 3vw, 40px); align-items: center; }

  @media (max-width: 860px) {
    .row { grid-template-columns: 1fr; }
    .side { width: min(320px, 80%); justify-self: center; }
  }
</style>
