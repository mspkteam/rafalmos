---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/shared/PageHero.astro';
import TrainingSpace from '../components/studio/TrainingSpace.astro';
import Community from '../components/studio/Community.astro';
import Merchandise from '../components/studio/Merchandise.astro';
import door from '../assets/studio/door.jpg';
---

<BaseLayout
  title="The Studio — Arte Algo, Granada, Spain"
  description="The Arte Algo studio in Granada, Spain: a fully equipped space to train, create and connect, open to visiting artists, workshops, residencies and collaborations."
>
  <PageHero eyebrow="Our Studio · Granada, Spain" lines={['The Studio']} image={door} imageAlt="The entrance door of the Arte Algo studio in Granada" focus="50% 55%">
    <p>A space to train, create and connect.</p>
  </PageHero>
  <TrainingSpace />
  <Community />
  <Merchandise />
</BaseLayout>
